{
  "name": "opic-ih-app",
  "version": "1.0.0",
  "private": true,
  "description": "App luyện nói OPIc IH",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "bundle": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=www/app.js",
    "build": "npm run content && npm run bundle",
    "serve": "npx http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "esbuild": "^0.28.2"
  }
}
