{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opic-oqc/08_DATA_SCHEMA.json",
  "title": "OPIc OQC knowledge base & app data schema",
  "x-schema-version": "1.0",
  "$defs": {
    "source": {
      "x-status": "MVP",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher_or_author",
        "source_type",
        "tier",
        "url",
        "publication_or_updated_date",
        "access_date",
        "page_language",
        "test_language",
        "format",
        "access_status",
        "copyright_or_reuse_status",
        "relevant_sections",
        "key_findings",
        "limitations",
        "confidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "publisher_or_author": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "official",
            "educational",
            "learner_report",
            "community",
            "AI_generated",
            "user_provided"
          ]
        },
        "tier": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "url": {
          "type": "string"
        },
        "publication_or_updated_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "page_language": {
          "type": "string"
        },
        "test_language": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "access_status": {
          "enum": [
            "accessible",
            "partial",
            "paywalled",
            "login_required",
            "unavailable",
            "snippet_only"
          ]
        },
        "copyright_or_reuse_status": {
          "type": "string"
        },
        "relevant_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_findings": {
